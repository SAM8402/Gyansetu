APP_NAME=Teacher AI Platform
DATABASE_URL=sqlite+aiosqlite:///./app.db
REDIS_URL=redis://localhost:6379/0
# NOTE: leave REDIS_URL empty/omitted to use the built-in in-memory cache
# (fakeredis, with a dependency-free emulator fallback) so free deployments
# need no external Redis; set it only when an external Redis server is
# available (required for multi-worker SSE progress).
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_CHAIN=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-pro,gemma-4-31b-it
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE=10485760
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@aura.edu
